{
  "name": "sigma-design",
  "version": "0.1.0",
  "description": "Sigma, an open design tool for AI-native teams: installed in your project, on your real design system.",
  "type": "module",
  "bin": {
    "sigma-design": "bin/sigma-design.mjs"
  },
  "exports": {
    "./bridge": "./tools/capture/bridge.js",
    "./capture": "./tools/capture/capture.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "index.html",
    "styles.css",
    "src/",
    "icon-sets/",
    "tools/",
    "!tools/test/",
    "!tools/build-*",
    "skills/",
    "docs/",
    "examples/optics/",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "start": "node bin/sigma-design.mjs standalone",
    "build:icons": "node tools/icons/build-ui.mjs",
    "build:welcome": "node tools/design-system/build.mjs",
    "test:node": "node --test tools/test/*.test.mjs",
    "test:package": "node tools/test/package-smoke.mjs",
    "build:figma": "node tools/figma/build.mjs",
    "postinstall": "node tools/terminal-install.mjs",
    "build:terminal": "node tools/build-terminal.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "design",
    "design-tokens",
    "design-system",
    "design-tool",
    "ai",
    "agents"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "openfig-core": "0.4.1"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ws": "8.22.0"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  }
}
