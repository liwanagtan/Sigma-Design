{
  "name": "sigma-design",
  "version": "0.1.0",
  "description": "Sigma, an open design tool for AI-native teams: installed in your project, on your real design system.",
  "type": "module",
  "bin": {
    "sigma-design": "bin/sigma-design.mjs"
  },
  "exports": {
    "./bridge": "./tools/capture/bridge.js",
    "./capture": "./tools/capture/capture.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "index.html",
    "styles.css",
    "src/",
    "icon-sets/",
    "tools/",
    "!tools/test/",
    "!tools/build-*",
    "skills/",
    "docs/schema/",
    "examples/optics/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "start": "node bin/sigma-design.mjs standalone",
    "build:welcome": "node tools/design-system/build.mjs",
    "build:pages": "node tools/design-system/build-pages.mjs",
    "test:node": "node --test tools/test/*.test.mjs",
    "build:figma": "node tools/figma/build.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "design",
    "design-tokens",
    "design-system",
    "design-tool",
    "ai",
    "agents"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "openfig-core": "0.4.1"
  }
}
