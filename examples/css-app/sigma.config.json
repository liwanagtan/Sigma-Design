{
  "schema": 1,
  "stack": {
    "styling": [
      "css-variables"
    ],
    "framework": "none"
  },
  "tokens": [
    {
      "sigma": ".sigma/tokens/acme.sigma.json",
      "name": "Acme tokens",
      "sources": [
        {
          "path": "src/styles/tokens.css",
          "format": "css-variables"
        }
      ],
      "naming": "kebab",
      "modes": {
        "Light": ":root",
        "Dark": "[data-theme=\"dark\"]"
      }
    }
  ],
  "workflow": {
    "git": "github",
    "tracker": "github",
    "branch": "design/{slug}",
    "base": "main",
    "labels": [
      "design"
    ]
  },
  "icons": [
    {
      "sigma": ".sigma/icons/acme-icons.sigma.json",
      "name": "Acme icons",
      "source": "src/assets/icons",
      "output": "svg"
    }
  ],
  "components": [
    {
      "sigma": ".sigma/design/acme-library.sigma.json",
      "source": "src/components",
      "manifest": ".sigma/captures/manifest.json",
      "styles": [
        "src/styles/app.css"
      ],
      "page": "/examples/css-app/components.html"
    }
  ],
  "pages": [
    {
      "sigma": ".sigma/design/acme-pages.sigma.json"
    }
  ]
}
