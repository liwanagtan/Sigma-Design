{
  "schema": 1,
  "stack": {
    "styling": [
      "js-theme"
    ],
    "framework": "react"
  },
  "tokens": [
    {
      "sigma": ".sigma/tokens/mui.sigma.json",
      "name": "Acme MUI tokens",
      "sources": [
        {
          "path": "src/theme.js",
          "format": "js-theme"
        }
      ],
      "naming": "path",
      "modes": {
        "Light": "lightTheme",
        "Dark": "darkTheme"
      },
      "adapter": ".sigma/adapters/tokens.mjs"
    }
  ],
  "notes": "Tokens come from src/theme.js through .sigma/adapters/tokens.mjs (written by the agent at setup): palette.* \u2192 Semantic (Light/Dark from lightTheme/darkTheme), shared spacing/shape/typography \u2192 Primitives. Code names are theme paths (palette.primary.main). Icons are the React components in src/icons, through .sigma/adapters/icons.mjs.",
  "workflow": {
    "git": "github",
    "tracker": "none",
    "branch": "design/{slug}",
    "base": "main",
    "labels": [
      "design"
    ]
  },
  "icons": [
    {
      "sigma": ".sigma/icons/mui-icons.sigma.json",
      "name": "Acme MUI icons",
      "source": "src/icons",
      "output": "react",
      "adapter": ".sigma/adapters/icons.mjs"
    }
  ]
}
